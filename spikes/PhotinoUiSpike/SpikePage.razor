@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="treadmill-interaction">
    <div class="treadmill-display">
        <div id="display" class="treadmill-display-visual-container"></div>
    </div>
    <div style="padding: 1rem; font-family: monospace;">
        <div>Host process working set: @_workingSetMb MB (WebView child processes are not included)</div>
        <div>Managed heap: @_managedMb MB</div>
        <div>Simulated walking speed: @_speed.ToString("F2")</div>
        <button class="btn" @onclick="ToggleWalking"><i class="fa-solid fa-person-walking"></i> Toggle walking mode</button>
    </div>
</div>

@code {
    private readonly CancellationTokenSource _cts = new();
    private bool _walking = true;
    private double _speed;
    private long _workingSetMb;
    private long _managedMb;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await JS.InvokeVoidAsync("TreadmillDisplay.initialize", "display");
        await JS.InvokeVoidAsync("TreadmillDisplay.setWalkingMode", _walking);
        _ = RunAsync(_cts.Token);
    }

    private async Task RunAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(100));
        var started = DateTime.UtcNow;
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                var t = (DateTime.UtcNow - started).TotalSeconds;
                _speed = 0.5 + 0.5 * Math.Sin(t / 2);
                await JS.InvokeVoidAsync("TreadmillDisplay.setSpeed", _speed);
                await JS.InvokeVoidAsync("TreadmillDisplay.setWalkingDirection", Math.Sin(t) * 0.5, 1.0);

                using var process = System.Diagnostics.Process.GetCurrentProcess();
                _workingSetMb = process.WorkingSet64 / (1024 * 1024);
                _managedMb = GC.GetTotalMemory(false) / (1024 * 1024);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task ToggleWalking()
    {
        _walking = !_walking;
        await JS.InvokeVoidAsync("TreadmillDisplay.setWalkingMode", _walking);
    }

    public async ValueTask DisposeAsync()
    {
        await _cts.CancelAsync();
        _cts.Dispose();
    }
}
