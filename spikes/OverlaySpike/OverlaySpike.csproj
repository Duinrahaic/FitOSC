<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <NoWarn>$(NoWarn);CS0649;CS0169;CS0414;CS8618;CS8625;CS8600;CS8602;CS8603;CS8604</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="SkiaSharp" Version="4.153.1" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.153.1" />
    </ItemGroup>
    <ItemGroup>
        <!-- Same OpenVR bindings and loaders FitOSC ships (v2.12.14). -->
        <Compile Include="..\..\FitOSC\OpenVR\openvr_api.cs" Link="openvr_api.cs" />
        <None Include="..\..\FitOSC\OpenVR\openvr_api.dll" Link="openvr_api.dll" CopyToOutputDirectory="PreserveNewest" />
        <None Include="..\..\FitOSC\OpenVR\libopenvr_api.so" Link="libopenvr_api.so" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
