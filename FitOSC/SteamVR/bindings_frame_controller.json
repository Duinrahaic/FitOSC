{
  "name": "FitOSC Default Bindings for Steam Frame Controllers",
  "controller_type": "frame_controller",
  "category": "steamvr_input",
  "bindings": {
    "/actions/fitosc": {
      "sources": [
        {
          "path": "/user/hand/right/input/thumbstick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/fitosc/in/SpeedModifier"
            }
          }
        },
        {
          "path": "/user/hand/right/input/bumper",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/fitosc/in/SpeedStepHold"
            }
          }
        },
        {
          "path": "/user/hand/right/input/menu",
          "mode": "complex_button",
          "inputs": {
            "long": {
              "output": "/actions/fitosc/in/RecenterYaw"
            }
          }
        },
        {
          "path": "/user/hand/left/input/thumbstick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/fitosc/in/ManualMovement"
            }
          }
        },
        {
          "path": "/user/hand/right/input/y",
          "mode": "button",
          "inputs": {}
        },
        {
          "path": "/user/hand/right/input/b",
          "mode": "button",
          "inputs": {}
        },
        {
          "path": "/user/hand/left/input/bumper",
          "mode": "button",
          "inputs": {}
        },
        {
          "path": "/user/hand/left/input/dpad_up",
          "mode": "button",
          "inputs": {}
        },
        {
          "path": "/user/hand/left/input/dpad_left",
          "mode": "button",
          "inputs": {}
        }
      ],
      "chords": [
        {
          "output": "/actions/fitosc/in/ToggleWalking",
          "inputs": [
            ["/user/hand/right/input/bumper", "click"],
            ["/user/hand/right/input/thumbstick", "click"]
          ]
        },
        {
          "output": "/actions/fitosc/in/TreadmillInclineUp",
          "inputs": [
            ["/user/hand/right/input/bumper", "click"],
            ["/user/hand/right/input/y", "click"]
          ]
        },
        {
          "output": "/actions/fitosc/in/TreadmillInclineDown",
          "inputs": [
            ["/user/hand/right/input/bumper", "click"],
            ["/user/hand/right/input/b", "click"]
          ]
        },
        {
          "output": "/actions/fitosc/in/TreadmillEnable",
          "inputs": [
            ["/user/hand/left/input/bumper", "click"],
            ["/user/hand/left/input/thumbstick", "click"]
          ]
        },
        {
          "output": "/actions/fitosc/in/TreadmillSpeedUp",
          "inputs": [
            ["/user/hand/left/input/bumper", "click"],
            ["/user/hand/left/input/dpad_up", "click"]
          ]
        },
        {
          "output": "/actions/fitosc/in/TreadmillSlowDown",
          "inputs": [
            ["/user/hand/left/input/bumper", "click"],
            ["/user/hand/left/input/dpad_left", "click"]
          ]
        }
      ]
    }
  }
}
