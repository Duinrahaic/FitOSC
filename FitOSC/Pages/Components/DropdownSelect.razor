@typeparam TValue
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="app-dropdown" @ref="_root">
    <button id="@Id" class="app-dropdown-trigger" type="button" role="combobox" aria-haspopup="listbox"
            aria-expanded="false" aria-controls="@(Id + "-listbox")" disabled="@Disabled">
        <span class="app-dropdown-value">@SelectedLabel</span>
        <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
    </button>
    <div class="app-dropdown-menu" id="@(Id + "-listbox")" role="listbox" aria-labelledby="@Id" hidden>
        @for (var index = 0; index < Options.Count; index++)
        {
            var option = Options[index];
            <button id="@(Id + "-option-" + index)" class="app-dropdown-option" type="button" role="option" tabindex="-1"
                    aria-selected="@(IsSelected(option) ? "true" : "false")" aria-disabled="@(option.Disabled ? "true" : "false")"
                    disabled="@option.Disabled" @onclick="() => Select(option)">
                <span class="app-dropdown-label">@option.Label</span>
                @if (IsSelected(option))
                {
                    <i class="fa-solid fa-check" aria-hidden="true"></i>
                }
            </button>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<DropdownOption<TValue>> Options { get; set; } = default!;
    [Parameter] public TValue Value { get; set; } = default!;
    [Parameter] public EventCallback<TValue> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private ElementReference _root;
    private IJSObjectReference? _module;

    private string SelectedLabel => Options.FirstOrDefault(IsSelected)?.Label ?? Value?.ToString() ?? "Select…";

    private bool IsSelected(DropdownOption<TValue> option) => EqualityComparer<TValue>.Default.Equals(Value, option.Value);

    private Task Select(DropdownOption<TValue> option) =>
        Disabled || option.Disabled ? Task.CompletedTask : ValueChanged.InvokeAsync(option.Value);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/dropdown.js");
        await _module.InvokeVoidAsync("initialize", _root);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("destroy", Id);
            await _module.DisposeAsync();
        }
    }
}
