@using FitOSC.Models
@using FitOSC.Services.OSC
@using FitOSC.Services.State
@using FitOSC.Services.Treadmill
@using FitOSC.Utilities
@inject AppStateService AppState
@inject TreadmillManager Treadmill
@inject IOscService OSC
@implements IDisposable

<div class="treadmill-control-adjuster-container @(_enabled ? string.Empty : "disabled")">
    <div class="treadmill-control-adjuster-indicator">
        <div class="treadmill-control-adjuster-indicator-value">
            @_value.ToString(_valueFormat)
        </div>
        <div class="treadmill-control-adjuster-indicator-title">
            @_unit
        </div>
    </div>
    <button class="treadmill-control-adjuster increase @_glow.ClassFor(_increase)"
            @onclick="Increase" type="button" aria-label="Increase @ControlType"
            aria-disabled="@AriaDisabled">
        <i class="fa fa-add" aria-hidden="true"></i>
    </button>
    <div class="treadmill-control-adjuster-title @(!_enabled ? "disabled" : "")">
        @_title
    </div>
    <button class="treadmill-control-adjuster decrease @_glow.ClassFor(_decrease)"
            @onclick="Decrease" type="button" aria-label="Decrease @ControlType"
            aria-disabled="@AriaDisabled">
        <i class="fa fa-minus" aria-hidden="true"></i>
    </button>
</div>

@code {
    [Parameter]
    public required TreadmillControlType ControlType { get; set; }

    private bool _enabled = false;
    private string _title = "Speed";
    private string _unit = "MPH";
    private decimal _value = 0m;
    private string _valueFormat = "F2";
    private TreadmillTelemetryValue? _data;
    private TreadmillConfiguration? _configuration;
    private ControlGlow _glow = null!;
    private RemoteControl _increase;
    private RemoteControl _decrease;

    // Disabled buttons still take clicks, so pressing one can play its feedback.
    private string? AriaDisabled => _enabled ? null : "true";
 
    
    protected override void OnInitialized()
    {
        (_increase, _decrease) = ControlType == TreadmillControlType.Incline
            ? (RemoteControl.TreadmillInclineIncrease, RemoteControl.TreadmillInclineDecrease)
            : (RemoteControl.TreadmillSpeedIncrease, RemoteControl.TreadmillSpeedDecrease);
        _glow = new ControlGlow(AppState, InvokeAsync, StateHasChanged, _increase, _decrease);
        AppStateOnAppStateUpdated(AppState.GetCurrentAppStateInfo());
        AppState.AppStateUpdated += AppStateOnAppStateUpdated;
        
    }

    private void AppStateOnAppStateUpdated(AppStateInfo stateInfo)
    {
        _configuration = stateInfo.TreadmillConfiguration;
        _enabled = AppState.IsEnabled(_increase);

        if (ControlType == TreadmillControlType.Incline &&
            stateInfo.TreadmillTelemetry.Values.TryGetValue(TreadmillTelemetryProperty.Incline, out _data))
        {
            _title = "INCLINE";
            _unit = "DEGREES";
            _valueFormat = "0.0";
            _value = _data.Value;
        }
        else if (ControlType == TreadmillControlType.Speed &&
                 stateInfo.TreadmillTelemetry.Values.TryGetValue(TreadmillTelemetryProperty.InstantaneousSpeed, out _data))
        {
            _title = "SPEED";
            _unit = stateInfo.UserMeasurementType == MeasurementType.Metric ? _data.MetricUnit : _data.ImperialUnit;
            var val = stateInfo.UserMeasurementType == MeasurementType.Metric ? _data.AsMetric().Value :  _data.AsImperial().Value;
            _value = Math.Round(val, 1, MidpointRounding.AwayFromZero);
            _valueFormat = "0.0";
        }
        else
        {
            // Feature not supported by treadmill
            _data = null;
        }
         InvokeAsync(StateHasChanged);
    }
    
    // Fixed increment: 0.2 mph (converted to km/h for treadmill)
    private readonly decimal _speedStepMph = 0.2m;
    private readonly decimal _speedStepKph = 0.2m * 1.609344m; // 0.2 mph = 0.321869 km/h

    private async Task Increase()
    {
        if (!AppState.PressControl(_increase) || _configuration is null)
            return;
        switch (ControlType)
        {
            case TreadmillControlType.Incline:
                await SetInclineByStep(true, _configuration.InclineIncrement);
                break;
            case TreadmillControlType.Speed:
                // Use fixed 0.2 mph increment
                await SetSpeedByStep(true, _speedStepKph);
                break;
        }
    }

    private async Task Decrease()
    {
        if (!AppState.PressControl(_decrease) || _configuration is null)
            return;
        switch (ControlType)
        {
            case TreadmillControlType.Incline:
                await SetInclineByStep(false, _configuration.InclineIncrement);
                break;
            case TreadmillControlType.Speed:
                // Use fixed 0.2 mph decrement
                await SetSpeedByStep(false, _speedStepKph);
                break;
        }
    }
 
    
    // Realistic minimum (0.5 km/h = 0.3 mph); the treadmill's reported range is applied by the manager.
    private const decimal MinimumSpeedKph = 0.5m;

    private async Task SetSpeedByStep(bool increase, decimal step)
    {
        var appState = AppState.GetCurrentAppStateInfo();
        var data = appState.TreadmillTelemetry.Values[TreadmillTelemetryProperty.InstantaneousSpeed];
        var currentSpeed = data.AsMetric().Value;
        var target = increase ? currentSpeed + step : currentSpeed - step;
        await Treadmill.SetSpeedAsync(Math.Max(target, MinimumSpeedKph));
    }

    // The treadmill's reported incline range is applied by the manager.
    private async Task SetInclineByStep(bool increase, decimal step)
    {
        var appState = AppState.GetCurrentAppStateInfo();
        var data = appState.TreadmillTelemetry.Values[TreadmillTelemetryProperty.Incline];
        var currentIncline = data.Value;
        var target = increase ? currentIncline + step : currentIncline - step;
        await Treadmill.SetInclineAsync(target);
    }
    
 
    public void Dispose()
    {
        AppState.AppStateUpdated -= AppStateOnAppStateUpdated;
        _glow.Dispose();
    }
}
