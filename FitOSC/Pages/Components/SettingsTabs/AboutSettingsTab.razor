@using FitOSC.Services
@inject UpdateCheckService UpdateCheckService
@implements IDisposable

<section class="page" aria-labelledby="settings-about-heading">
    <h2 id="settings-about-heading">About</h2>

    <div class="row">
        <div class="lab">
            <span class="t">FitOSC @UpdateCheckService.CurrentVersion</span>
            <small aria-live="polite">
                @if (_isChecking)
                {
                    <span class="spin" aria-hidden="true"></span><text>Checking…</text>
                }
                else if (UpdateCheckService.UpdateAvailable)
                {
                    <text>Version @UpdateCheckService.LatestVersion is available.</text>
                }
                else if (_hasChecked)
                {
                    <text>You're up to date.</text>
                }
                else
                {
                    <text>Current version</text>
                }
            </small>
        </div>
        @if (UpdateCheckService.UpdateAvailable)
        {
            <button class="settings-btn primary" type="button" @onclick="OpenUpdateUrl">Download update</button>
        }
        else
        {
            <button class="settings-btn" type="button" @onclick="CheckForUpdates" disabled="@_isChecking">Check for updates</button>
        }
    </div>

    <h3>Project</h3>
    <div class="links">
        <a class="link" href="https://www.duinrahaic.app/fitosc" target="_blank">User guide <span>www.duinrahaic.app</span></a>
        <a class="link" href="https://github.com/duinrahaic/FitOSC" target="_blank">Source code <span>GitHub</span></a>
        <a class="link" href="https://discord.gg/aZQfy6H9fA" target="_blank">Discord <span>Help &amp; feedback</span></a>
        <a class="link" href="https://www.duinrahaic.com" target="_blank">Website <span>www.duinrahaic.com</span></a>
        <a class="link" href="https://github.com/duinrahaic" target="_blank">GitHub <span>@@duinrahaic</span></a>
        <a class="link" href="https://bsky.app/profile/duinrahaic.app" target="_blank">Bluesky <span>@@duinrahaic.app</span></a>
        <a class="link" href="https://x.com/duinrahaic" target="_blank">X <span>@@duinrahaic</span></a>
        <a class="link" href="https://vrchat.com/home/user/usr_30b4e812-e6b1-4200-b563-ef74e89ea266" target="_blank">VRChat <span>Duinrahaic</span></a>
    </div>

    <h3>Support</h3>
    <div class="links">
        <a class="link" href="https://ko-fi.com/duinrahaic" target="_blank">Ko-fi <span>Tips</span></a>
