@using FitOSC.Services
@inject UpdateCheckService UpdateCheckService
@implements IDisposable

<section class="page about" aria-label="About">
    <header class="about-id">
        <img src="images/FitOSC-Bunny.svg" alt=""/>
        <div class="about-name">
            <span class="about-title">FitOSC</span>
            <span class="about-version" aria-live="polite">
                @if (_isChecking)
                {
                    <span class="spin" aria-hidden="true"></span><text>Checking for updates…</text>
                }
                else if (UpdateCheckService.UpdateAvailable)
                {
                    <text>Version @UpdateCheckService.CurrentVersion. </text><span class="about-new">@UpdateCheckService.LatestVersion is available.</span>
                }
                else if (_hasChecked)
                {
                    <text>Version @UpdateCheckService.CurrentVersion is up to date.</text>
                }
                else
                {
                    <text>Version @UpdateCheckService.CurrentVersion</text>
                }
            </span>
        </div>
        @if (UpdateCheckService.UpdateAvailable)
        {
            <button class="settings-btn primary" type="button" @onclick="OpenUpdateUrl">Download @UpdateCheckService.LatestVersion</button>
        }
        else
        {
            <button class="settings-btn" type="button" @onclick="CheckForUpdates" disabled="@_isChecking">Check for updates</button>
        }
    </header>

    <nav class="about-links group" aria-label="FitOSC links">
        <a href="https://www.duinrahaic.app/fitosc" target="_blank"><i class="fa-solid fa-book-open" aria-hidden="true"></i>User guide</a>
        <a href="https://discord.gg/aZQfy6H9fA" target="_blank"><i class="fa-brands fa-discord" aria-hidden="true"></i>Discord</a>
        <a href="https://github.com/duinrahaic/FitOSC" target="_blank"><i class="fa-solid fa-code" aria-hidden="true"></i>Source code</a>
        <a href="https://www.duinrahaic.com" target="_blank"><i class="fa-solid fa-globe" aria-hidden="true"></i>Website</a>
        <a href="https://ko-fi.com/duinrahaic" target="_blank"><i class="fa-solid fa-heart kofi" aria-hidden="true"></i>Support on Ko-fi</a>
        <a href="https://duinrahaic.booth.pm/" target="_blank"><i class="fa-solid fa-store" aria-hidden="true"></i>Shop on Booth</a>
    </nav>

    <nav class="about-chips" aria-label="Duinrahaic">
        <a href="https://github.com/duinrahaic" target="_blank"><i class="fa-brands fa-github" aria-hidden="true"></i>GitHub</a>
        <a href="https://bsky.app/profile/duinrahaic.app" target="_blank"><i class="fa-brands fa-bluesky" aria-hidden="true"></i>Bluesky</a>
        <a href="https://x.com/duinrahaic" target="_blank"><i class="fa-brands fa-x-twitter" aria-hidden="true"></i>X</a>
        <a href="https://vrchat.com/home/user/usr_30b4e812-e6b1-4200-b563-ef74e89ea266" target="_blank"><i class="fa-solid fa-vr-cardboard" aria-hidden="true"></i>VRChat</a>
    </nav>

    <p class="about-credits">
        Built with
        <a href="https://avaloniaui.net/" target="_blank">Avalonia</a>,
        <a href="https://github.com/LucHeart/CoreOSC-UTF8-ASYNC" target="_blank">CoreOSC</a>,
        <a href="https://github.com/ValveSoftware/openvr" target="_blank">OpenVR</a>,
        <a href="https://github.com/Natsumi-sama/OscQueryLibrary" target="_blank">OscQueryLibrary</a>,
        <a href="https://serilog.net/" target="_blank">Serilog</a>,
        <a href="https://threejs.org/" target="_blank">Three.js</a> and
        <a href="https://fontawesome.com/" target="_blank">Font Awesome</a>.
    </p>
</section>

@code {
    private bool _isChecking;
    private bool _hasChecked;

    protected override void OnInitialized()
    {
        UpdateCheckService.UpdateAvailableChanged += HandleUpdateAvailableChanged;
    }

    private void HandleUpdateAvailableChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task CheckForUpdates()
    {
        _isChecking = true;
        _hasChecked = false;
        StateHasChanged();

        try
        {
            await UpdateCheckService.CheckForUpdatesManuallyAsync();
            _hasChecked = true;
        }
        finally
        {
            _isChecking = false;
            StateHasChanged();
        }
    }

    private void OpenUpdateUrl()
    {
        if (!string.IsNullOrEmpty(UpdateCheckService.ReleaseUrl))
        {
            try
            {
                System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo
                {
                    FileName = UpdateCheckService.ReleaseUrl,
                    UseShellExecute = true
                });
            }
            catch
            {
                // Silently fail if we can't open the browser
            }
        }
    }

    public void Dispose()
    {
        UpdateCheckService.UpdateAvailableChanged -= HandleUpdateAvailableChanged;
    }
}
