@using FitOSC.Models
@using FitOSC.Services.State
@using FitOSC.Services.Treadmill
@using FitOSC.Services.Configuration
@using FitOSC.Services.OpenVR
@using Valve.VR
@inject AppStateService AppStateService
@inject ConfigurationService ConfigService
@inject OpenVRService OpenVRService
@inject FitOSC.Services.SteamVRDriver.SteamVRDriverService SteamVRDriver
@implements IDisposable

<section class="page" aria-labelledby="settings-diagnostics-heading">
    <div class="diagnostics-head">
        <h2 id="settings-diagnostics-heading">Diagnostics</h2>
        <p class="note console"><span>Developer console:</span><span><kbd>Ctrl</kbd> <kbd>Shift</kbd> <kbd>I</kbd></span></p>
    </div>

    <h3>Status</h3>
    <div class="group">
        <dl>
            <dt>Treadmill</dt><dd class="@StatusClass(AppInterface.Bluetooth)">@TreadmillStatus</dd>
            <dt>Connection</dt><dd>@ConnectionDescription</dd>
            <dt>Driver</dt><dd>@ConfigService.GetConfiguration().Treadmill.TreadmillType</dd>
            <dt>VR</dt><dd class="@StatusClass(AppInterface.VR)">@(FitOSC.App.DisableVR ? "Off (started with --no-vr)" : GetStatus(AppInterface.VR).ToString())</dd>
            <dt>OSC</dt><dd class="@StatusClass(AppInterface.OSC)">@GetStatus(AppInterface.OSC)</dd>
        </dl>
    </div>

    <h3>Walking</h3>
    <div class="group">
        <dl>
            <dt>Mode</dt><dd>@(_appState?.Walking.Mode.ToString() ?? "Unknown")</dd>
            <dt>Output</dt><dd class="@OutputStatusClass">@OutputDescription</dd>
            <dt>Max speed</dt><dd>@($"{_appState?.Walking.Config.MaxSpeed:F2} km/h")</dd>
            <dt>Trim</dt><dd>@($"{_appState?.Walking.Config.WalkingTrim:F2}")</dd>
            <dt>Manual override</dt><dd>@(_appState?.Walking.IsManualOverride == true ? "Active" : "Inactive")</dd>
        </dl>
    </div>

    <h3>Telemetry</h3>
    <div class="group">
        <dl>
            <dt>State</dt><dd>@(_appState?.TreadmillState.ToString() ?? "Unknown")</dd>
            <dt>Speed</dt><dd>@GetTelemetryData(TreadmillTelemetryProperty.InstantaneousSpeed)</dd>
            <dt>Distance</dt><dd>@GetTelemetryData(TreadmillTelemetryProperty.TotalDistance)</dd>
            <dt>Pace</dt><dd>@GetTelemetryData(TreadmillTelemetryProperty.InstantaneousPace)</dd>
            <dt>Calories</dt><dd>@GetTelemetryData(TreadmillTelemetryProperty.Calories)</dd>
            <dt>Heart rate</dt><dd>@GetTelemetryData(TreadmillTelemetryProperty.HeartRate)</dd>
            <dt>Incline</dt><dd>@GetTelemetryData(TreadmillTelemetryProperty.Incline)</dd>
        </dl>
    </div>

    <h3>VR</h3>
    <div class="group">
        @if (_vrData is null)
        {
            <p class="note">Tracking and locomotion values appear when SteamVR is running.</p>
        }
        else
        {
            <dl>
                <dt>Yaw</dt><dd>@($"{_vrData.Yaw:F3} rad ({_vrData.Yaw * 180 / Math.PI:F1}°)")</dd>
                <dt>Pitch</dt><dd>@($"{_vrData.Pitch:F3} rad ({_vrData.Pitch * 180 / Math.PI:F1}°)")</dd>
                <dt>Roll</dt><dd>@($"{_vrData.Roll:F3} rad ({_vrData.Roll * 180 / Math.PI:F1}°)")</dd>
                <dt>Position</dt><dd>@($"X={_vrData.PositionX:F2}, Y={_vrData.PositionY:F2}, Z={_vrData.PositionZ:F2}")</dd>
                <dt>Turn command</dt><dd>@_vrData.Turn</dd>
                <dt>Forward output</dt><dd>@($"{_verticalOutput:F3}")</dd>
                <dt>Strafe output</dt><dd>@($"{_horizontalOutput:F3}")</dd>
                <dt>Counter-steer</dt><dd>@($"{-_vrData.HorizontalAdjustment:F3}")</dd>
            </dl>
        }
    </div>

    <h3>Controllers</h3>
    <div class="group">
        @if (_controllerInfo != null && (_controllerInfo.LeftConnected || _controllerInfo.RightConnected))
        {
            <dl>
                <dt>Type</dt><dd>@_controllerInfo.GetControllerDisplayName() (@(_controllerInfo.HasThumbsticks() ? "thumbstick" : "trackpad"))</dd>
                <dt>Left</dt><dd>@(_controllerInfo.LeftConnected ? $"X {_vrData?.LeftThumbstickX ?? 0:F3} · Y {_vrData?.LeftThumbstickY ?? 0:F3}" : "Not connected")</dd>
                <dt>Right</dt><dd>@(_controllerInfo.RightConnected ? $"Y {_vrData?.RightThumbstickY ?? 0:F3}" : "Not connected")</dd>
                <dt>Speed modifier</dt><dd>@($"{1f + (_vrData?.RightThumbstickY ?? 0):F2}x")</dd>
            </dl>
        }
        else
        {
            <p class="note">No controllers detected.</p>
        }
    </div>
</section>

@code {
    private AppStateInfo? _appState;
    private OpenVRDataEvent? _vrData;
    private float _verticalOutput;
    private float _horizontalOutput;
    private System.Threading.Timer? _updateTimer;
    private ControllerInfo? _controllerInfo;

    private bool IsMetric => ConfigService.GetConfiguration().User.PreferMetric;

    private string TreadmillStatus => GetStatus(AppInterface.Bluetooth) == ConnectionStatus.Connected && _appState?.DeviceName is { } name
        ? $"Connected · {name}"
        : GetStatus(AppInterface.Bluetooth).ToString();

    private string ConnectionDescription
    {
        get
        {
            var connection = ConfigService.GetConfiguration().Treadmill.Connection;
            return connection.Type == BluetoothConnectionType.ESPHome
                ? $"ESPHome relay · {connection.Host}:{connection.Port}"
                : "This PC";
        }
    }

    protected override void OnInitialized()
    {
        AppStateService.AppStateUpdated += UpdateAppState;
        _appState = AppStateService.GetCurrentAppStateInfo();
        OpenVRService.OnDataUpdateReceived += UpdateVRData;
        _controllerInfo = OpenVRService.GetControllerInfo();

        // Refresh locomotion outputs and controller info every 100ms.
        _updateTimer = new System.Threading.Timer(_ => UpdateLocomotionOutputs(), null, 0, 100);
    }

    private void UpdateAppState(AppStateInfo info)
    {
        _appState = info;
        InvokeAsync(StateHasChanged);
    }

    private void UpdateVRData(OpenVRDataEvent data)
    {
        _vrData = data;
        InvokeAsync(StateHasChanged);
    }

    private void UpdateLocomotionOutputs()
    {
        _controllerInfo = OpenVRService.GetControllerInfo();

        if (_appState != null && _vrData != null)
        {
            _verticalOutput = _appState.Walking.Mode switch
            {
                WalkingMode.Dynamic => CalculateDynamicVelocity(),
                WalkingMode.Override => CalculateOverrideVelocity(),
                _ => 0f
            };

            // Horizontal strafe (inverted yaw adjustment)
            _horizontalOutput = -_vrData.HorizontalAdjustment;

            InvokeAsync(StateHasChanged);
        }
    }

    private float CalculateDynamicVelocity()
    {
        if (_appState?.TreadmillTelemetry == null) return 0f;

        var speedValue = _appState.TreadmillTelemetry.GetTelemetryValue(TreadmillTelemetryProperty.InstantaneousSpeed);
        if (speedValue == null) return 0f;

        float normalizedSpeed = (float)(speedValue.Value / _appState.Walking.Config.MaxSpeed);
        normalizedSpeed = Math.Clamp(normalizedSpeed, 0f, 1f);
        return normalizedSpeed * _appState.Walking.Config.WalkingTrim;
    }

    private float CalculateOverrideVelocity()
    {
        if (_appState?.Walking.Config.CurrentOverrideIndex >= 0 &&
            _appState?.Walking.Config.CurrentOverrideIndex < _appState?.Walking.Config.OverrideSpeeds.Count)
        {
            return _appState.Walking.Config.OverrideSpeeds[_appState.Walking.Config.CurrentOverrideIndex];
        }
        return 0f;
    }

    private bool IsJoystickOutput => _appState?.Walking.Config.Output == LocomotionOutput.Joystick;

    private string OutputDescription => IsJoystickOutput ? $"Joystick ({SteamVRDriver.Status})" : "OSC";

    private string? OutputStatusClass => IsJoystickOutput ? StatusClass(AppInterface.SteamVRDriver) : null;

    private ConnectionStatus GetStatus(AppInterface interfaceType) =>
        _appState?.ConnectionStates.TryGetValue(interfaceType, out var status) == true ? status : ConnectionStatus.Disconnected;

    private string? StatusClass(AppInterface interfaceType) => GetStatus(interfaceType) switch
    {
        ConnectionStatus.Connected => "ok",
        ConnectionStatus.Connecting => "busy",
        ConnectionStatus.Error => "error",
        _ => null
    };

    private string GetTelemetryData(TreadmillTelemetryProperty property)
    {
        var telemetryValue = _appState?.TreadmillTelemetry?.GetTelemetryValue(property);
        if (telemetryValue == null) return "—";
        return (IsMetric ? telemetryValue.AsMetric() : telemetryValue.AsImperial()).ToString();
    }

    public void Dispose()
    {
        AppStateService.AppStateUpdated -= UpdateAppState;
        OpenVRService.OnDataUpdateReceived -= UpdateVRData;
        _updateTimer?.Dispose();
    }
}
