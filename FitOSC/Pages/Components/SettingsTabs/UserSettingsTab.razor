@using FitOSC.Models
@using FitOSC.Services
@using FitOSC.Services.History
@inject HistoryService HistoryService
@inject UpdateService UpdateService
@implements IDisposable

<section class="page" aria-labelledby="settings-general-heading">
    <h2 id="settings-general-heading">General</h2>

    <div class="group">
        <div class="row inline">
            <div class="lab"><span class="t" id="settings-units-label">Units</span></div>
            <div class="ctl seg" role="radiogroup" aria-labelledby="settings-units-label">
                <label><input type="radio" name="settings-units" checked="@Draft.PreferMetric" @onchange="() => SetPreferMetric(true)" /><span>Metric</span></label>
                <label><input type="radio" name="settings-units" checked="@(!Draft.PreferMetric)" @onchange="() => SetPreferMetric(false)" /><span>Imperial</span></label>
            </div>
        </div>
    </div>

    <h3>History</h3>
    <div class="group">
        <div class="row inline">
            <div class="lab"><label for="settings-history-enabled">Save walking sessions</label></div>
            <input class="switch" type="checkbox" role="switch" id="settings-history-enabled"
                   @bind="Draft.HistoryEnabled" @bind:after="Notify" />
        </div>
        @if (Draft.HistoryEnabled)
        {
            <div class="row">
                <div class="lab">
                    <label for="settings-min-duration">Minimum saved session</label>
                </div>
                <div class="ctl w-sm">
                    <div class="unit">
                        <input type="number" id="settings-min-duration" aria-describedby="settings-min-duration-error" min="1" max="60" step="1"
                               aria-invalid="@(Draft.MinimumSessionDurationError is null ? null : "true")"
                               @bind="Draft.MinimumSessionDuration" @bind:after="Notify" /><span>min</span>
                    </div>
                    <FieldError Id="settings-min-duration-error" Message="@Draft.MinimumSessionDurationError" />
                </div>
            </div>
        }
    </div>

    <h3>System</h3>
    <div class="group">
        <div class="row inline">
            <div class="lab">
                <label for="settings-gpu">Hardware acceleration</label>
            </div>
            <input class="switch" type="checkbox" role="switch" id="settings-gpu"
                   @bind="Draft.UseHardwareAcceleration" @bind:after="Notify" />
        </div>
        <div class="row inline">
            <div class="lab"><label for="settings-steamvr">Launch with SteamVR</label></div>
            <input class="switch" type="checkbox" role="switch" id="settings-steamvr"
                   @bind="Draft.LaunchWithSteamVR" @bind:after="Notify" />
        </div>
    </div>

    @if (UpdateService.IsInstalled)
    {
        <h3>Updates</h3>
        <div class="group">
            <div class="row inline">
                <div class="lab"><label for="settings-auto-update">Automatic updates</label></div>
                <input class="switch" type="checkbox" role="switch" id="settings-auto-update"
                       @bind="Draft.AutoUpdate" @bind:after="Notify" />
            </div>
            <div class="row inline">
                <div class="lab"><span class="t" id="settings-channel-label">Channel</span></div>
                <div class="ctl seg" role="radiogroup" aria-labelledby="settings-channel-label">
                    <label><input type="radio" name="settings-channel" checked="@(Draft.UpdateChannel == UpdateChannel.Stable)" @onchange="() => SetUpdateChannel(UpdateChannel.Stable)" /><span>Stable</span></label>
                    <label><input type="radio" name="settings-channel" checked="@(Draft.UpdateChannel == UpdateChannel.Dev)" @onchange="() => SetUpdateChannel(UpdateChannel.Dev)" /><span>Dev</span></label>
                </div>
            </div>
            <div class="row inline">
                <div class="lab" role="status"><span class="t">@UpdateStatusText</span></div>
                @if (UpdateService.Status is UpdateStatus.Available or UpdateStatus.Ready)
                {
                    <button class="settings-btn primary" type="button" @onclick="UpdateService.InstallAsync">@(UpdateService.IsChannelSwitch ? "Restart to switch" : "Restart to update")</button>
                }
                else
                {
                    <button class="settings-btn" type="button" @onclick="UpdateService.CheckAsync"
                            disabled="@(UpdateService.Status is UpdateStatus.Checking or UpdateStatus.Downloading)">Check now</button>
                }
            </div>
        </div>
    }

    <div class="row actions">
        <button class="settings-btn" type="button" @onclick="RunSetup">Run setup</button>
        <button class="settings-btn danger" type="button" @onclick="ClearHistory">@(_confirmClear ? "Delete all history" : "Clear history")</button>
    </div>
    @if (_clearStatus is not null)
    {
        <p class="note spaced" role="status">@_clearStatus</p>
    }
</section>

@code {
    [Parameter, EditorRequired] public SettingsDraft.GeneralDraft Draft { get; set; } = default!;
    [Parameter] public EventCallback Changed { get; set; }
    [Parameter] public EventCallback RunSetup { get; set; }

    private bool _confirmClear;
    private string? _clearStatus;
    private CancellationTokenSource? _confirmTimeout;

    private Task Notify() => Changed.InvokeAsync();

    private Task SetPreferMetric(bool preferMetric)
    {
        Draft.PreferMetric = preferMetric;
        return Notify();
    }

    private Task SetUpdateChannel(UpdateChannel channel)
    {
        Draft.UpdateChannel = channel;
        return Notify();
    }

    private string UpdateStatusText => UpdateService.Status switch
    {
        UpdateStatus.Checking => "Checking…",
        UpdateStatus.Available => $"{UpdateService.NewVersion} available",
        UpdateStatus.Downloading => $"Downloading {UpdateService.NewVersion} · {UpdateService.DownloadProgress}%",
        UpdateStatus.Ready => $"{UpdateService.NewVersion} ready",
        UpdateStatus.Failed => "Couldn't check for updates",
        _ => "Up to date"
    };

    protected override void OnInitialized() => UpdateService.Changed += HandleUpdateChanged;

    private void HandleUpdateChanged() => InvokeAsync(StateHasChanged);

    private void ClearHistory()
    {
        _confirmTimeout?.Cancel();
        if (_confirmClear)
        {
            HistoryService.ClearAllHistory();
            _confirmClear = false;
            _clearStatus = "History cleared.";
            return;
        }

        _confirmClear = true;
        _clearStatus = "This can't be undone.";
        _confirmTimeout = new CancellationTokenSource();
        _ = DisarmClearAsync(_confirmTimeout.Token);
    }

    private async Task DisarmClearAsync(CancellationToken token)
    {
        try { await Task.Delay(TimeSpan.FromSeconds(5), token); }
        catch (OperationCanceledException) { return; }
        await InvokeAsync(() =>
        {
            _confirmClear = false;
            _clearStatus = null;
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        _confirmTimeout?.Cancel();
        UpdateService.Changed -= HandleUpdateChanged;
    }
}
