@using Avalonia.Controls.ApplicationLifetimes
@using FitOSC.Models
@using FitOSC.Services
@using FitOSC.Services.Configuration
@using FitOSC.Services.State
@using FitOSC.Services.Treadmill
@using FitOSC.Utilities.BLE
@inject ConfigurationService ConfigService
@inject TreadmillManager TreadmillManager
@inject AppStateService AppStateService
@inject OnboardingService OnboardingService
@inject ILogger<OnboardingModal> Logger
@implements IDisposable

@if (IsOpen)
{
    <div class="modal-overlay">
        <div class="onboarding-modal" role="dialog" aria-modal="true" aria-labelledby="onboarding-title">
            <header class="ob-bar">
                <div class="ob-icon" aria-hidden="true">
                    @if (_step == WizardStep.Start)
                    {
                        <img src="images/FitOSC-Bunny.svg" alt="" />
                    }
                    else
                    {
                        <i class="@StepIcon(_step)"></i>
                    }
                </div>
                <h2 id="onboarding-title">@StepTitle(_step)</h2>
                <ol class="ob-steps" aria-label="Setup progress">
                    @foreach (var step in Enum.GetValues<WizardStep>())
                    {
                        <li class="@StepState(step)" aria-current="@(step == _step ? "step" : null)">
                            <span class="visually-hidden">@StepTitle(step)@(IsSkipped(step) ? ", skipped" : "")</span>
                            <span aria-hidden="true">@((int)step + 1)</span>
                        </li>
                    }
                </ol>
            </header>

            <div class="ob-body">
                @switch (_step)
                {
                    case WizardStep.Start:
                        <p class="ob-instruction">Choose how you'll use FitOSC. You can change these later in Settings.</p>
                        <div class="ob-field" role="radiogroup" aria-labelledby="ob-treadmill">
                            <span class="ob-label" id="ob-treadmill">Treadmill</span>
                            <div class="ob-options">
                                <button type="button" role="radio" class="ob-option large" aria-checked="@Checked(_useTreadmill)" @onclick="() => SetUseTreadmill(true)">
                                    <i class="fa-brands fa-bluetooth-b" aria-hidden="true"></i>
                                    <span>Connected<small>FitOSC reads your treadmill</small></span>
                                </button>
                                <button type="button" role="radio" class="ob-option large" aria-checked="@Checked(!_useTreadmill)" @onclick="() => SetUseTreadmill(false)">
                                    <i class="fa-solid fa-link-slash" aria-hidden="true"></i>
                                    <span>Not connected<small>You set the speed</small></span>
                                </button>
                            </div>
                        </div>
                        <div class="ob-field" role="radiogroup" aria-labelledby="ob-mode">
                            <span class="ob-label" id="ob-mode">Walking mode</span>
                            <div class="ob-options">
                                <button type="button" role="radio" class="ob-option large" aria-checked="@Checked(_walkingMode == WalkingMode.Dynamic)"
                                        disabled="@(!_useTreadmill)" @onclick="() => _walkingMode = WalkingMode.Dynamic">
                                    <i class="fa-solid fa-wave-square" aria-hidden="true"></i>
                                    <span>Dynamic<small>@(_useTreadmill ? "Follows your treadmill speed" : "Needs a connected treadmill")</small></span>
                                </button>
                                <button type="button" role="radio" class="ob-option large" aria-checked="@Checked(_walkingMode == WalkingMode.Override)"
                                        @onclick="() => _walkingMode = WalkingMode.Override">
                                    <i class="fa-solid fa-arrows-left-right-to-line" aria-hidden="true"></i>
                                    <span>Override<small>Walks at a preset speed</small></span>
                                </button>
                            </div>
                        </div>
                        <div class="ob-field" role="radiogroup" aria-labelledby="ob-units">
                            <span class="ob-label" id="ob-units">Units</span>
                            <div class="ob-options">
                                <button type="button" role="radio" class="ob-option" aria-checked="@Checked(_preferMetric)" @onclick="() => _preferMetric = true">
                                    <i class="fa-solid fa-ruler" aria-hidden="true"></i>
                                    <span>km/h<small>Metric</small></span>
                                </button>
                                <button type="button" role="radio" class="ob-option" aria-checked="@Checked(!_preferMetric)" @onclick="() => _preferMetric = false">
                                    <i class="fa-solid fa-ruler" aria-hidden="true"></i>
                                    <span>mph<small>Imperial</small></span>
                                </button>
                            </div>
                        </div>
                        break;

                    case WizardStep.Driver:
                        <p class="ob-instruction">Pick the driver that matches your treadmill. Not sure? Start with <b>@TreadmillDrivers.Find(TreadmillType.FTMS)?.Name</b>.</p>
                        <div class="ob-options" role="radiogroup" aria-label="Treadmill driver">
                            @foreach (var driver in TreadmillDrivers.All)
                            {
                                <button type="button" role="radio" class="ob-option" aria-checked="@Checked(_treadmillType == driver.Type)"
                                        @onclick="() => _treadmillType = driver.Type">
                                    @driver.Name
                                    @if (driver.Experimental)
                                    {
                                        <i class="fa-solid fa-flask ob-experimental" title="Experimental" aria-label="Experimental"></i>
                                    }
                                </button>
                            }
                        </div>
                        @if (TreadmillDrivers.Find(_treadmillType) is { } selected)
                        {
                            <div class="ob-panel" aria-live="polite">
                                @selected.Description
                                @if (selected.Experimental)
                                {
                                    <span class="ob-warning"><i class="fa-solid fa-flask" aria-hidden="true"></i>Experimental. Some readings or controls may not work yet.</span>
                                }
                            </div>
                        }
                        break;

                    case WizardStep.Connect:
                        <p class="ob-instruction">Turn on your treadmill, scan for it, then connect to it from the list.</p>
                        <BluetoothConnectionEditor Settings="_connection" Disabled="@(_isScanning || _isConnecting || IsConnected)" Changed="OnConnectionChanged" />
                        <div class="ob-field">
                            <span class="ob-label">
                                Treadmills found
                                <button type="button" class="ob-btn small" @onclick="ScanForDevices" disabled="@(_isScanning || _isConnecting || IsConnected)">
                                    <i class="fa-solid @(_isScanning ? "fa-spinner fa-spin" : "fa-magnifying-glass")" aria-hidden="true"></i>
                                    @(_isScanning ? "Scanning" : "Scan")
                                </button>
                            </span>
                            <div class="ob-devices" aria-live="polite">
                                @foreach (var device in Devices())
                                {
                                    var connected = IsConnected && device == ConnectedDevice;
                                    <div class="ob-device @(connected ? "connected" : "")">
                                        <i class="fa-brands fa-bluetooth-b" aria-hidden="true"></i>
                                        <span class="ob-device-name">@BaseBluetoothClient.Label(device)</span>
                                        @if (connected)
                                        {
                                            <span class="ob-connected"><i class="fa-solid fa-check" aria-hidden="true"></i>Connected</span>
                                            <button type="button" class="ob-btn small" @onclick="DisconnectTreadmill">Disconnect</button>
                                        }
                                        else
                                        {
                                            <button type="button" class="ob-btn small" @onclick="() => ConnectToDevice(device)" disabled="@(_isScanning || _isConnecting || IsConnected)">
                                                @if (_isConnecting && _connectingDevice == device)
                                                {
                                                    <i class="fa-solid fa-spinner fa-spin" aria-hidden="true"></i>
                                                }
                                                Connect
                                            </button>
                                        }
                                    </div>
                                }
                                @if (_hasScanned && !_isScanning && !Devices().Any())
                                {
                                    <p class="ob-empty">No treadmills found. Make sure yours is on and not connected to another app.</p>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(TreadmillManager.LastConnectionError))
                            {
                                <p class="ob-error" role="alert">@TreadmillManager.LastConnectionError</p>
                            }
                        </div>
                        break;

                    case WizardStep.Walkies:
                        <div class="ob-walkies-heading">
                            <div>
                                <p>Looking for a community?</p>
                                <h3>Come walk with us!</h3>
                            </div>
                            <a href="@WalkiesPageUrl" target="_blank">About Walkies <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a>
                        </div>
                        <img class="ob-banner" src="images/Walkies-Banner.webp" alt="Members of the Walkies VRChat community walking together" />
                        <div class="ob-panel ob-group">
                            <img src="images/VRChat.png" alt="" />
                            <div>
                                <small>VRChat group code</small>
                                <b>@WalkiesGroupCode</b>
                            </div>
                            <button type="button" class="ob-btn small" @onclick="CopyGroupCode">
                                <i class="fa-solid @(_copied ? "fa-check" : "fa-copy")" aria-hidden="true"></i>
                                @(_copied ? "Copied" : "Copy")
                            </button>
                            <a class="ob-btn small" href="@WalkiesGroupUrl" target="_blank"><img src="images/VRChat.png" alt="" />Join on VRChat</a>
                        </div>
                        break;
                }
            </div>

            <footer class="ob-footer">
                @if (_step == WizardStep.Start)
                {
                    <button type="button" class="ob-btn quiet" @onclick="SkipWizard">Skip setup</button>
                }
                else
                {
                    <button type="button" class="ob-btn quiet" @onclick="PreviousStep"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i>Back</button>
                }
                <span class="ob-spacer"></span>
                @if (_step == WizardStep.Connect && !IsConnected)
                {
                    <button type="button" class="ob-btn quiet" @onclick="NextStep">Connect later</button>
                }
                @if (_step == WizardStep.Walkies)
                {
                    <button type="button" class="ob-btn primary" @onclick="CompleteOnboarding">Finish setup<i class="fa-solid fa-check" aria-hidden="true"></i></button>
                }
                else
                {
                    <button type="button" class="ob-btn primary" @onclick="NextStep" disabled="@(_step == WizardStep.Connect && !IsConnected)">
                        Next<i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                    </button>
                }
            </footer>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    private const string WalkiesGroupCode = "Walkies.0659";
    private const string WalkiesGroupUrl = "https://vrchat.com/home/group/grp_cefd37c8-5f4b-4933-9346-75ab850329c9";
    private const string WalkiesPageUrl = "https://www.duinrahaic.app/communities/walkies";

    private enum WizardStep
    {
        Start,
        Driver,
        Connect,
        Walkies
    }

    private WizardStep _step = WizardStep.Start;
    private bool _useTreadmill = true;
    private WalkingMode _walkingMode = WalkingMode.Dynamic;
    private bool _preferMetric = true;
    private TreadmillType _treadmillType = TreadmillType.FTMS;
    private BluetoothConnectionSettings _connection = new();

    private bool _isScanning;
    private bool _hasScanned;
    private bool _isConnecting;
    private string? _connectingDevice;
    private List<string> _discoveredDevices = new();
    private bool _copied;

    private AppStateInfo? _appState;
    private bool IsConnected => _appState?.ConnectionStates.TryGetValue(AppInterface.Bluetooth, out var status) == true
                                && status == ConnectionStatus.Connected;
    private string? ConnectedDevice => _appState?.DeviceName;

    private bool _wasOpen;

    protected override void OnInitialized()
    {
        AppStateService.AppStateUpdated += UpdateAppState;
        OnboardingService.OnShowOnboarding += ShowOnboarding;
        _appState = AppStateService.GetCurrentAppStateInfo();
    }

    private void ShowOnboarding()
    {
        ResetWizardState();
        IsOpen = true;
    }

    protected override void OnParametersSet()
    {
        if (IsOpen && !_wasOpen)
        {
            ResetWizardState();
        }
        _wasOpen = IsOpen;
    }

    private void ResetWizardState()
    {
        var config = ConfigService.GetConfiguration();

        _step = WizardStep.Start;
        _useTreadmill = true;
        _walkingMode = config.WalkingMode.DefaultMode == WalkingMode.Override ? WalkingMode.Override : WalkingMode.Dynamic;
        _preferMetric = config.User.PreferMetric;
        _treadmillType = config.Treadmill.TreadmillType;
        _connection = config.Treadmill.Connection with { };
        _isScanning = false;
        _hasScanned = false;
        _isConnecting = false;
        _connectingDevice = null;
        _discoveredDevices.Clear();
        _copied = false;
    }

    private void UpdateAppState(AppStateInfo info)
    {
        _appState = info;
        InvokeAsync(StateHasChanged);
    }

    private static string StepTitle(WizardStep step) => step switch
    {
        WizardStep.Start => "Welcome to FitOSC",
        WizardStep.Driver => "Treadmill driver",
        WizardStep.Connect => "Connect your treadmill",
        _ => "Walkies"
    };

    private static string StepIcon(WizardStep step) => step switch
    {
        WizardStep.Driver => "fa-solid fa-microchip",
        WizardStep.Connect => "fa-brands fa-bluetooth-b",
        _ => "fa-solid fa-person-walking"
    };

    private static string Checked(bool value) => value ? "true" : "false";

    /// <summary>Driver and Connect only apply when FitOSC reads the treadmill.</summary>
    private bool IsSkipped(WizardStep step) => !_useTreadmill && step is WizardStep.Driver or WizardStep.Connect;

    private string StepState(WizardStep step) =>
        IsSkipped(step) ? "skipped" : step == _step ? "current" : step < _step ? "done" : "";

    private void SetUseTreadmill(bool useTreadmill)
    {
        _useTreadmill = useTreadmill;
        if (!useTreadmill)
            _walkingMode = WalkingMode.Override;
    }

    private void NextStep()
    {
        var next = Enum.GetValues<WizardStep>().FirstOrDefault(step => step > _step && !IsSkipped(step), _step);
        _step = next;
    }

    private void PreviousStep()
    {
        var previous = Enum.GetValues<WizardStep>().LastOrDefault(step => step < _step && !IsSkipped(step), _step);
        _step = previous;
    }

    private IEnumerable<string> Devices()
    {
        if (IsConnected && !string.IsNullOrEmpty(ConnectedDevice))
            return _discoveredDevices.Where(device => device != ConnectedDevice).Prepend(ConnectedDevice);
        return _discoveredDevices;
    }

    private async Task ScanForDevices()
    {
        _isScanning = true;
        _hasScanned = true;
        _discoveredDevices.Clear();

        try
        {
            // Several short scans so devices appear as they are found.
            var found = new HashSet<string>();
            for (var i = 0; i < 5; i++)
            {
                found.UnionWith(await TreadmillManager.ScanAsync(TimeSpan.FromSeconds(2), _connection));
                _discoveredDevices = found.ToList();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error scanning for devices");
        }
        finally
        {
            _isScanning = false;
        }
    }

    private void OnConnectionChanged()
    {
        _discoveredDevices.Clear();
        _hasScanned = false;
    }

    private async Task ConnectToDevice(string deviceName)
    {
        _isConnecting = true;
        _connectingDevice = deviceName;

        try
        {
            await TreadmillManager.ConnectAsync(deviceName, _treadmillType, _connection);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error connecting to device {DeviceName}", deviceName);
        }
        finally
        {
            _isConnecting = false;
            _connectingDevice = null;
        }
    }

    private Task DisconnectTreadmill() => TreadmillManager.DisconnectAsync();

    // The app window's clipboard, not the web page's: it needs no page focus or browser permission.
    private async Task CopyGroupCode()
    {
        await Avalonia.Threading.Dispatcher.UIThread.InvokeAsync(() =>
        {
            var window = ((IClassicDesktopStyleApplicationLifetime)Avalonia.Application.Current!.ApplicationLifetime!).MainWindow!;
            return window.Clipboard!.SetTextAsync(WalkiesGroupCode);
        });
        _copied = true;
    }

    private async Task CompleteOnboarding()
    {
        var config = ConfigService.GetConfiguration();

        config.Treadmill.TreadmillType = _treadmillType;
        config.Treadmill.Connection = _connection with { };
        config.WalkingMode.DefaultMode = _walkingMode;
        config.User.PreferMetric = _preferMetric;

        if (IsConnected && !string.IsNullOrEmpty(ConnectedDevice))
        {
            config.Treadmill.LastDeviceName = ConnectedDevice;
            config.Treadmill.AutoConnect = true;
        }

        config.User.OnboardingCompleted = true;

        ConfigService.SaveConfiguration(config);
        Logger.LogInformation("Onboarding completed. TreadmillType={TreadmillType}, WalkingMode={WalkingMode}, PreferMetric={PreferMetric}",
            _treadmillType, _walkingMode, _preferMetric);

        AppStateService.UpdatePreferredUnits(_preferMetric);

        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task SkipWizard()
    {
        var config = ConfigService.GetConfiguration();
        config.User.OnboardingCompleted = true;

        ConfigService.SaveConfiguration(config);
        Logger.LogInformation("Onboarding wizard skipped, marked as completed");

        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    public void Dispose()
    {
        AppStateService.AppStateUpdated -= UpdateAppState;
        OnboardingService.OnShowOnboarding -= ShowOnboarding;
    }
}
