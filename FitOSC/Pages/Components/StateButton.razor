@using FitOSC.Services.State
@inject AppStateService AppState
@implements IDisposable
<button class="treadmill-control-button @(Remote is { } remote ? _glow?.ClassFor(remote) : null)" disabled="@(!Enabled)" @onclick="HandleClick">
    <i class="@Icon"></i>
    <div class="treadmill-control-button-title @(!Enabled ? "disabled" : "")">
        @Title
    </div>
</button>
@code {
    [Parameter] public bool Enabled { get; set; } = true;
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Icon { get; set; } = "fa-solid fa-circle";
    [Parameter] public EventCallback OnClick { get; set; }
    /// <summary>The SteamVR binding that presses this button, if any.</summary>
    [Parameter] public RemoteControl? Remote { get; set; }

    private RemoteGlow? _glow;

    protected override void OnInitialized()
    {
        if (Remote is { } remote)
            _glow = new RemoteGlow(AppState, InvokeAsync, StateHasChanged, remote);
    }

    private async Task HandleClick()
    {
        if (Enabled)
        {
            await OnClick.InvokeAsync();
        }
    }

    public void Dispose() => _glow?.Dispose();
}
