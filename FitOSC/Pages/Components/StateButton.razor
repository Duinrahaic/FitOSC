@using FitOSC.Services.State
@inject AppStateService AppState
@implements IDisposable
<button class="treadmill-control-button @_glow.ClassFor(Control)" type="button" aria-disabled="@(Enabled ? null : "true")" @onclick="HandleClick">
    <i class="@Icon"></i>
    <div class="treadmill-control-button-title @(!Enabled ? "disabled" : "")">
        @Title
    </div>
</button>
@code {
    [Parameter] public bool Enabled { get; set; } = true;
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Icon { get; set; } = "fa-solid fa-circle";
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter, EditorRequired] public RemoteControl Control { get; set; }

    private RemoteGlow _glow = null!;

    protected override void OnInitialized() =>
        _glow = new RemoteGlow(AppState, InvokeAsync, StateHasChanged, Control);

    private async Task HandleClick()
    {
        if (AppState.PressControl(Control))
            await OnClick.InvokeAsync();
    }

    public void Dispose() => _glow.Dispose();
}
