@using FitOSC.Services
@using FitOSC.Services.Configuration
@using FitOSC.Services.Midi
@using Valve.VR
@using FitOSC.Services.Pulsoid
@using FitOSC.Services.State
@using FitOSC.Services.WebSocket
@using FitOSC.Pages.Components.SettingsTabs
@inject ConfigurationService ConfigService
@inject UpdateCheckService UpdateCheckService
@inject AppStateService AppStateService
@inject OpenVRService OpenVRService
@inject WebSocketService WebSocketService
@inject PulsoidService PulsoidService
@inject MidiService MidiService
@inject OnboardingService OnboardingService
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (IsOpen && _draft is not null && _baseline is not null)
{
    <div class="modal-overlay" @onclick="RequestClose">
        <div class="settings-window" @ref="_window" role="dialog" aria-modal="true" aria-labelledby="settings-title" @onclick:stopPropagation="true">
            <header class="settings-head">
                <h1 id="settings-title">Settings</h1>
                <button class="settings-btn quiet icon" type="button" aria-label="Close settings" @onclick="RequestClose" disabled="@_isSaving">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            </header>

            <div class="settings-body" inert="@(_isSaving ? "" : null)">
                <nav class="settings-menu" aria-label="Settings sections">
                    @foreach (var menuPage in Enum.GetValues<SettingsPage>())
                    {
                        <button type="button" class="@(_draft.IsChanged(menuPage, _baseline) ? "dirty" : null)"
                                aria-current="@(menuPage == _activePage ? "page" : null)" @onclick="() => _activePage = menuPage">
                            @menuPage.ToString()<span class="dot" aria-hidden="true"></span>
                        </button>
                    }
                    <div class="settings-version" aria-label="FitOSC version @UpdateCheckService.CurrentVersion">
                        <span>Version</span><span>@UpdateCheckService.CurrentVersion</span>
                    </div>
                </nav>

                <div class="settings-pane" @key="_activePage">
                    @switch (_activePage)
                    {
                        case SettingsPage.General:
                            <UserSettingsTab Draft="_draft.General" Changed="DraftChanged" RunSetup="RunSetup" />
                            break;
                        case SettingsPage.Treadmill:
                            <TreadmillSettingsTab Draft="_draft.Treadmill" Baseline="_baseline.Treadmill" ShowValidation="_saveAttempted"
                                                  Changed="DraftChanged" Connected="AcceptConnectedTreadmill" />
                            break;
                        case SettingsPage.Walking:
                            <WalkingSettingsTab Draft="_draft.Walking" Metric="_draft.General.PreferMetric" Changed="DraftChanged" />
                            break;
                        case SettingsPage.Integrations:
                            <IntegrationsSettingsTab Draft="_draft.Integrations" Changed="DraftChanged" />
                            break;
                        case SettingsPage.Diagnostics:
                            <DebugSettingsTab />
                            break;
                        case SettingsPage.About:
                            <AboutSettingsTab />
                            break;
                    }
                </div>
            </div>

            <footer class="settings-foot @(HasChanges || _closeBlocked ? "attention" : null)">
                <span class="state" role="status" aria-live="polite">@FooterText</span>
                <button class="settings-btn quiet" type="button" @onclick="Close" disabled="@_isSaving">Cancel</button>
                <button class="settings-btn primary" type="button" data-settings-save @onclick="Save" disabled="@(!HasChanges || _isSaving)">@(_isSaving ? "Saving…" : "Save")</button>
            </footer>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    private SettingsDraft? _draft;
    private SettingsDraft? _baseline;
    private SettingsPage _activePage = SettingsPage.General;
    private bool _saveAttempted;
    private bool _closeBlocked;
    private bool _isSaving;
    private bool _keyboardInitialized;
    private ElementReference _window;
    private IJSObjectReference? _keyboardModule;

    private bool HasChanges => Enum.GetValues<SettingsPage>().Any(page => _draft!.IsChanged(page, _baseline!));

    private string FooterText
    {
        get
        {
            if (_isSaving)
                return "Saving…";
            if (_saveAttempted && _draft!.ErrorCount(_baseline!) is var errors and > 0)
                return errors == 1 ? "1 field needs fixing" : $"{errors} fields need fixing";
            if (!HasChanges)
                return "No unsaved changes";
            if (_closeBlocked)
                return "Save or cancel your changes first";
            return _draft!.General.UseHardwareAcceleration != _baseline!.General.UseHardwareAcceleration
                ? "Unsaved changes · restart required"
                : "Unsaved changes";
        }
    }

    protected override void OnParametersSet()
    {
        if (!IsOpen)
        {
            _draft = _baseline = null;
            return;
        }
        if (_draft is not null)
            return;

        var config = ConfigService.GetConfiguration();
        var autoLaunch = OpenVR.Applications is null ? config.OpenVR.AutoLaunch : OpenVRService.GetAutoLaunch();
        _baseline = SettingsDraft.From(config, autoLaunch, WebSocketService.IsEnabled);
        _draft = _baseline.Clone();
        _activePage = SettingsPage.General;
        _saveAttempted = false;
        _closeBlocked = false;
        _keyboardInitialized = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!IsOpen || _keyboardInitialized)
            return;

        _keyboardModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/settings.js");
        await _keyboardModule.InvokeVoidAsync("initialize", _window);
        _keyboardInitialized = true;
    }

    private void DraftChanged() => _closeBlocked = false;

    private void AcceptConnectedTreadmill()
    {
        var saved = ConfigService.GetConfiguration().Treadmill;
        _baseline!.AcceptConnectedTreadmill(saved);
    }

    private async Task RequestClose()
    {
        if (_isSaving)
            return;
        if (HasChanges)
        {
            _closeBlocked = true;
            return;
        }
        await Close();
    }

    private async Task RunSetup()
    {
        await Close();
        OnboardingService.TriggerOnboarding();
    }

    public async Task Close()
    {
        IsOpen = false;
        _draft = _baseline = null;
        await IsOpenChanged.InvokeAsync(IsOpen);
    }

    private async Task Save()
    {
        if (_isSaving || !HasChanges)
            return;

        _isSaving = true;
        try { await SaveDraft(); }
        finally { _isSaving = false; }
    }

    private async Task SaveDraft()
    {
        var draft = _draft!;
        var baseline = _baseline!;
        if (draft.FirstPageWithErrors(baseline) is { } invalidPage)
        {
            _saveAttempted = true;
            _activePage = invalidPage;
            return;
        }

        var config = ConfigService.GetConfiguration();
        var general = draft.General;
        var generalChanged = draft.IsChanged(SettingsPage.General, baseline);
        if (generalChanged)
        {
            config.User.PreferMetric = general.PreferMetric;
            config.User.HistoryEnabled = general.HistoryEnabled;
            config.User.MinimumSessionDuration = general.MinimumSessionDuration;
            config.User.UseHardwareAcceleration = general.UseHardwareAcceleration;
            config.OpenVR.AutoLaunch = general.LaunchWithSteamVR;
        }

        if (draft.IsChanged(SettingsPage.Treadmill, baseline))
        {
            var connection = draft.Treadmill.TrimmedConnection;
            if (config.Treadmill.Connection != connection)
                config.Treadmill.LastDeviceName = null;
            config.Treadmill.Connection = connection;
            config.Treadmill.TreadmillType = draft.Treadmill.TreadmillType;
            config.Treadmill.AutoConnect = draft.Treadmill.AutoConnect;
        }

        if (draft.IsChanged(SettingsPage.Walking, baseline))
        {
            var walking = draft.Walking;
            config.WalkingMode.MaxSpeed = walking.MaxSpeedKph;
            config.WalkingMode.DefaultMode = walking.DefaultMode;
            config.WalkingMode.DefaultTrim = walking.DefaultTrim;
            config.WalkingMode.SmoothingFactor = walking.SmoothingFactor;
            config.WalkingMode.MaxTurnAngle = walking.MaxTurnAngle;
            config.WalkingMode.UpdateIntervalMs = walking.UpdateIntervalMs;
            config.WalkingMode.ThumbstickRampSpeed = walking.ThumbstickRampSpeed;
        }

        var integrations = draft.Integrations;
        if (draft.IsChanged(SettingsPage.Integrations, baseline))
        {
            config.WebSocket.Enabled = integrations.WebSocketEnabled;
            config.Pulsoid.Enabled = integrations.PulsoidEnabled;
            config.Pulsoid.ApiKey = integrations.PulsoidApiKey;
            config.Midi.Enabled = integrations.MidiEnabled;
            config.Midi.OutputDeviceName = integrations.MidiOutputDevice;
            config.Midi.Channel = integrations.MidiChannel;
            config.Midi.SpeedCC = integrations.MidiSpeedCC;
            config.Midi.HeartRateCC = integrations.MidiHeartRateCC;
            config.Midi.InclineCC = integrations.MidiInclineCC;
        }

        ConfigService.SaveConfiguration(config);

        // Apply saved changes to the running services.
        if (general.PreferMetric != baseline.General.PreferMetric)
            AppStateService.UpdatePreferredUnits(general.PreferMetric);
        if (general.LaunchWithSteamVR != baseline.General.LaunchWithSteamVR)
            OpenVRService.SetAutoLaunch(general.LaunchWithSteamVR);
        if (integrations.WebSocketEnabled != baseline.Integrations.WebSocketEnabled)
        {
            if (integrations.WebSocketEnabled)
                WebSocketService.Enable();
            else
                await WebSocketService.DisableAsync();
        }
        if (integrations.PulsoidChanged(baseline.Integrations))
            await PulsoidService.ReconnectAsync();
        if (integrations.MidiChanged(baseline.Integrations))
            MidiService.Reconnect();

        await Close();
    }

    public async ValueTask DisposeAsync()
    {
        if (_keyboardModule is not null)
            await _keyboardModule.DisposeAsync();
    }
}
