@using FitOSC.Models
@using FitOSC.Services.State
@using FitOSC.Services.Treadmill
@using FitOSC.Services
@inject TreadmillManager Treadmill
@inject AppStateService AppState
@inject UpdateService UpdateService
@implements IDisposable

<div class="treadmill-controls">
    <ButtonAdjuster ControlType="TreadmillControlType.Speed"/>
    <ButtonAdjuster ControlType="TreadmillControlType.Incline"/>
    <div class="treadmill-controls-group">
        <div class="treadmill-utility-bar">
            <InterfaceStatusIndicator Interface="AppInterface.Bluetooth" />
            <InterfaceStatusIndicator Interface="AppInterface.VR" />
            <InterfaceStatusIndicator Interface="AppInterface.OSC" />
            @if (UpdateService.Status is UpdateStatus.Available or UpdateStatus.Downloading or UpdateStatus.Ready)
            {
                <button class="icon active" id="update" type="button" @onclick="UpdateService.InstallAsync" aria-label="@UpdateTitle" title="@UpdateTitle">
                    <i class="fa-solid fa-circle-up" aria-hidden="true"></i>
                </button>
            }
            <button class="icon" type="button" @onclick="OpenSettings" aria-label="Settings">
                <i class="fa-solid fa-cog" aria-hidden="true"></i>
            </button>
        </div>
        <div class="title">
            FITOSC
        </div>
        <img src="images/FitOSC-Bunny.svg" alt="fitosc-logo"/>

        <div class="treadmill-control-row">
            <StateButton OnClick="Treadmill.StartAsync" Enabled="@Accepts(TreadmillCommands.Start)" Icon="fa fa-play" Title="START"/>
            <StateButton OnClick="Treadmill.PauseAsync" Enabled="@Accepts(TreadmillCommands.Pause)" Icon="fa fa-pause" Title="PAUSE"/>
            <StateButton OnClick="Treadmill.StopAsync" Enabled="@Accepts(TreadmillCommands.Stop)" Icon="fa fa-square" Title="STOP"/>
        </div>
    </div>

    <WalkingButtonAdjuster Enabled="true" />

</div>

<SettingsModal @bind-IsOpen="_isSettingsOpen" />

@code {
    private bool _isSettingsOpen = false;
    private AppStateInfo? _treadmillData;
    private TreadmillCommands _renderedCommands = TreadmillCommands.None;
    private UpdateStatus _renderedUpdateStatus;

    private bool IsBluetoothConnected =>
        _treadmillData?.ConnectionStates.TryGetValue(AppInterface.Bluetooth, out var status) == true
        && status == ConnectionStatus.Connected; // Only enable when fully connected, not while scanning

    // The buttons the connected treadmill takes; its configuration can change after it connects.
    private TreadmillCommands AvailableCommands =>
        IsBluetoothConnected ? _treadmillData!.TreadmillConfiguration.Commands : TreadmillCommands.None;

    private bool Accepts(TreadmillCommands command) => AvailableCommands.HasFlag(command);

    protected override void OnInitialized()
    {
        AppState.AppStateUpdated += UpdateTreadmillData;
        UpdateService.Changed += HandleUpdateChanged;
    }

    private string UpdateTitle =>
        UpdateService.Status == UpdateStatus.Downloading ? $"Downloading {UpdateService.NewVersion}"
        : UpdateService.IsChannelSwitch ? $"Restart to switch to {UpdateService.NewVersion}"
        : $"Restart to update to {UpdateService.NewVersion}";

    private void HandleUpdateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void UpdateTreadmillData(AppStateInfo? obj)
    {
        _treadmillData = obj;

        // Only re-render if the available commands changed (affects button enabled states). App state is one instance
        // updated in place, so compare with what was last rendered rather than with the previous update.
        if (AvailableCommands != _renderedCommands)
        {
            InvokeAsync(StateHasChanged);
        }
    }

    // Prevent unnecessary re-renders - child components handle their own updates
    protected override bool ShouldRender()
    {
        var currentCommands = AvailableCommands;
        var updateStatus = UpdateService.Status;
        var shouldRender = currentCommands != _renderedCommands || updateStatus != _renderedUpdateStatus || _isSettingsOpen;
        _renderedCommands = currentCommands;
        _renderedUpdateStatus = updateStatus;
        return shouldRender;
    }

    private void OpenSettings()
    {
        _isSettingsOpen = true;
    }

    public void Dispose()
    {
        AppState.AppStateUpdated -= UpdateTreadmillData;
        UpdateService.Changed -= HandleUpdateChanged;
    }
}
